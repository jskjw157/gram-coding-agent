<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.haar.gram-agent.tunnel</string>
	<key>ProgramArguments</key>
	<array>
		<string>/bin/zsh</string>
		<string>__GRAM_AGENT_REPO_ROOT__/platform/macos/launchd/run-tunnel.sh</string>
	</array>
	<key>UserName</key>
	<string>mac_ops</string>
	<key>WorkingDirectory</key>
	<string>__GRAM_AGENT_REPO_ROOT__</string>
	<key>RunAtLoad</key>
	<false/>
	<key>KeepAlive</key>
	<true/>
	<key>ThrottleInterval</key>
	<integer>30</integer>
	<key>StandardOutPath</key>
	<string>/Users/mac_ops/Library/Logs/gram-agent/tunnel.out.log</string>
	<key>StandardErrorPath</key>
	<string>/Users/mac_ops/Library/Logs/gram-agent/tunnel.err.log</string>
	<key>Umask</key>
	<integer>63</integer>
</dict>
</plist>
