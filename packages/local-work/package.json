{
  "name": "@gram/local-work",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint src",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "work": "node dist/cli.js"
  },
  "dependencies": {
    "@gram/domain": "workspace:*",
    "@gram/filesystem": "workspace:*",
    "@gram/policy": "workspace:*",
    "@gram/shell": "workspace:*",
    "@gram/secrets": "workspace:*"
  },
  "devDependencies": {
    "typescript": "6.0.3",
    "vitest": "5.0.0"
  }
}
