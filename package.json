{
  "name": "gram-coding-agent",
  "private": true,
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "pnpm -r build",
    "lint": "pnpm -r lint && eslint tests/security",
    "typecheck": "pnpm -r typecheck && tsc -p tests/security/tsconfig.secret-boundary.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "vitest run --config tests/e2e/vitest.config.ts",
    "test:security": "node tests/security/run-security.mjs",
    "test:security:wsl": "vitest run --config tests/security/vitest.wsl-isolation.config.ts --configLoader runner",
    "test:owner-native": "vitest run --config tests/security/owner-native.vitest.config.ts --configLoader runner"
  },
  "devDependencies": {
    "@eslint/js": "latest",
    "@types/node": "latest",
    "eslint": "latest",
    "prettier": "latest",
    "typescript": "^6.0.0",
    "typescript-eslint": "latest",
    "vitest": "latest"
  }
}
